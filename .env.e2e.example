# E2E environment for Playwright (pnpm test:e2e). Copy to .env.e2e; .env.e2e is gitignored.
# Loaded via `dotenv -e .env.e2e -- next dev`, so these override the regular .env.
# Backend: vocab-management-be-2 on :3100 (its own .env.e2e).
NESTJS_API_URL=http://localhost:3100/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3101
NEXT_PUBLIC_API_URL=http://localhost:3101/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3100
# Auth0 dev tenant, for the FE login flow. Same values as .env; the callback URL and logout URL
# http://localhost:3101/api/auth/callback and http://localhost:3101/ must be allowed on the app.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
# Test users created by hand in the dev tenant (email verified, password set). Never real accounts.
E2E_AUTH0_USER_EMAIL=
E2E_AUTH0_USER_PASSWORD=
E2E_AUTH0_ADMIN_EMAIL=
E2E_AUTH0_ADMIN_PASSWORD=
# Empty overrides the value in .env: no cookie domain on localhost
COOKIE_DOMAIN=
# Keep observability off during E2E
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=
RESEND_API_KEY=
NEXT_TELEMETRY_DISABLED=1
