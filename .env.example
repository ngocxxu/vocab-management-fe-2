# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NESTJS_API_URL=http://localhost:3000

# Connect AI page: public HTTPS URL of the backend MCP endpoint (BE MCP_RESOURCE_URL, e.g. https://api.example.com/api/v1/mcp).
# Cloud AI clients cannot reach localhost, so use a tunnel for local tests. Leave empty to show "not configured".
NEXT_PUBLIC_MCP_URL=

# Production: set if auth cookies use a shared domain (e.g. .yourdomain.com) so signout can clear them
COOKIE_DOMAIN=.yourdomain.com

# WebSocket Configuration
# Set this to your WebSocket server URL (e.g., your backend server)
# Example: ws://localhost:3000 or wss://your-domain.com
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3002

# Authentication: Auth0 Regular Web Application (one tenant per environment)
# Callback URL to allow in Auth0: <NEXT_PUBLIC_APP_URL>/api/auth/callback
# Logout URL to allow in Auth0:   <NEXT_PUBLIC_APP_URL>/
# AUTH0_AUDIENCE must equal the backend's AUTH0_AUDIENCE, and "Allow Offline Access" must be on for that API.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Monitoring (optional)
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=your_better_stack_token
NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=https://in.logs.betterstack.com

# Environment
NODE_ENV=development

CLOUDINARY_URL=

# Email — Resend (support contact form)
# Sign up at resend.com, create an API key, then add it here
RESEND_API_KEY=re_your_resend_api_key

# Server Actions encryption key (production builds; optional in dev)
# Next.js makes a random key on every build. Without a fixed key, each build/instance
# has different Server Action IDs, so old tabs fail with "Failed to find Server Action".
# Generate once with: openssl rand -base64 32
# Use the SAME value for every build and every instance. Keep it secret.
# Docker: pass as a build arg (see Dockerfile and docs/server-actions-key.md).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Error monitoring — Sentry
# The switches are the ONLY control. A DSN says WHERE to send, never WHETHER.
# Both must be the exact string 'true' to enable capture; anything else is off.
# SENTRY_ENABLED is server-side and never reaches the browser bundle.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
# Deployment label, not a control. Set it per deployment: NODE_ENV is hardcoded
# to 'production' in the Docker image, so staging and prod would otherwise be
# indistinguishable in Sentry. Falls back to NODE_ENV when unset.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

# Source map upload (CI only — see next.config.ts)
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
